{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/console", "destination": "/console.html" },
    { "source": "/deck", "destination": "/deck.html" },
    { "source": "/v/:id", "destination": "/reveal.html" },
    { "source": "/api/:path*", "destination": "/api/[...path].mjs?path=:path*" }
  ]
}
